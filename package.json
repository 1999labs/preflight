{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "description": "Launch-QA readiness checks for OpenAI-compatible LLM endpoints",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "preflight": "./dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "preflight": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx test/run.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
